{
    "editor.formatOnSave": false,
    "clangd.arguments": [
        "--query-driver=C:/Program Files (x86)/Dev-Cpp/**/bin/g++.exe,C:/Program Files (x86)/Dev-Cpp/**/bin/*.exe,**",
        "--header-insertion=never",
        "--background-index"
    ],
    "files.associations": {
        "*.h": "cpp",
        "*.hpp": "cpp"
    },
    "code-runner.executorMap": {
        "cpp": "cd $workspaceRoot && build.bat"
    },
    "code-runner.runInTerminal": true,
    "code-runner.saveFileBeforeRun": true
}
